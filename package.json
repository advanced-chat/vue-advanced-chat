{
  "name": "@advanced-chat/components",
  "version": "3.0.0-alpha.1",
  "license": "MIT",
  "description": "A beautiful chat component library made with Vue",
  "contributors": [
    {
      "email": "antoindupontdev@gmail.com",
      "name": "Antoine Dupont"
    },
    {
      "email": "aaron@advancedchat.org",
      "name": "Aaron Nwabuoku"
    }
  ],
  "type": "module",
  "main": "dist/components.umd.cjs",
  "module": "dist/components.js",
  "unpkg": "dist/components.umd.cjs",
  "jsdelivr": "dist/components.umd.cjs",
  "style": "dist/components.css",
  "typings": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.umd.cjs"
    },
    "./styles": {
      "types": "./dist/src/styles.d.ts",
      "import": "./dist/components.css"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vuejs",
    "chat",
    "vue-js-chat",
    "multiple",
    "group",
    "rooms",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advanced-chat/vue-advanced-chat.git"
  },
  "bugs": {
    "url": "https://github.com/advanced-chat/vue-advanced-chat/issues"
  },
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write src/ .storybook/",
    "format:check": "prettier --check src/ .storybook/",
    "test:storybook": "vitest run --project storybook",
    "test": "npm run test:storybook",
    "verify:pack": "node ./scripts/verify-pack.mjs",
    "verify:storybook-ui": "node ./scripts/verify-storybook-ui.mjs",
    "verify:storybook-flows": "node ./scripts/verify-storybook-flows.mjs",
    "verify": "npm run format:check && npm run type-check && npm run lint && npm run test:storybook && npm run build && npm run verify:pack && npm run build-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{vue,ts,js,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.14.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.0",
    "micromark-extension-gfm-tagfilter": "^2.0.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-util-combine-extensions": "^2.0.0",
    "micromark-util-types": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/vue3-vite": "^10.2.17",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.0.3",
    "eslint-plugin-storybook": "^10.2.17",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.2.17",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
